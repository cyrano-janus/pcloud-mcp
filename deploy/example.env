# Copy to .env on the target server. Never put secrets in this file.
# Fill with your actual pCloud owner and permitted folder ID (0 = entire account).
PCLOUD_REGION=eu
PCLOUD_USER_ID=
PCLOUD_ROOT_FOLDER_ID=
PCLOUD_ENABLE_WRITES=false
PCLOUD_MCP_MAX_FRAME_BYTES=8388608
# Domain with a valid TLS certificate mounted in ./secrets.
PCLOUD_MCP_PUBLIC_URL=https://mcp.example.com/mcp
# External OAuth 2.1 authorization server. Introspection must return the
# configured issuer, audience, subject, expiration, issued-at, type and scopes.
PCLOUD_MCP_OAUTH_ISSUER=https://identity.example.com
PCLOUD_MCP_INTROSPECTION_URL=https://identity.example.com/introspect
PCLOUD_MCP_OAUTH_CLIENT_ID=
PCLOUD_MCP_OAUTH_SUBJECT=
